# Copy to .env and fill in.

# A long random password for evrd's database.
POSTGRES_PASSWORD=

# Encrypts saved network passwords (SASL, server passwords) and secret
# settings. Make one with:
#   docker run --rm --entrypoint evrctl ghcr.io/4evrd/evrd genkey
# and keep a copy somewhere safe.
EVRD_SECRET_KEY=

# Pin a release instead of latest, e.g. 0.1.0.
# EVRD_VERSION=latest

# Ports on this host: the web app, and IRC (TLS).
# WEB_PORT=8080
# IRC_PORT=6697
