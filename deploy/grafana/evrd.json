{
  "uid": "evrd",
  "title": "evrd",
  "tags": [
    "evrd",
    "irc"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "1m",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "editable": true,
  "graphTooltip": 1,
  "description": "evrd, the IRC bouncer: traffic, upstream links, clients, sign-ins and nodes (OpenTelemetry metrics in VictoriaMetrics)",
  "templating": {
    "list": [
      {
        "name": "node",
        "label": "Node",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "victoriametrics"
        },
        "query": {
          "query": "label_values(evrd_cluster_users, service_instance_id)",
          "refId": "node"
        },
        "definition": "label_values(evrd_cluster_users, service_instance_id)",
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "refresh": 2
      }
    ]
  },
  "links": [
    {
      "title": "evrd admin",
      "type": "link",
      "url": "https://evrd.ircforever.org/admin/metrics",
      "targetBlank": true
    }
  ],
  "panels": [
    {
      "type": "row",
      "title": "Now",
      "id": 1,
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "type": "stat",
      "title": "Links connected",
      "id": 2,
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "description": "Connections to IRC networks that are registered",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum (max by (status, service_instance_id) (last_over_time(evrd_upstream_connections{service_instance_id=~\"$node\",status=\"connected\"}[2m])))",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "instant": false,
          "range": true
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto",
        "justifyMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
