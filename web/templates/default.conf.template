# A template: the nginx image fills in ${EVRD_API} (where evrd's API is,
# default evrd-api:8098) and ${NGINX_LOCAL_RESOLVERS} (the container's DNS)
# at startup. Resolving per request keeps working when evrd is recreated
# with a new address (an upgrade, a restart).
server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    resolver ${NGINX_LOCAL_RESOLVERS} valid=10s ipv6=off;
    set $evrd_api http://${EVRD_API};

    # The API lives on the daemon; proxying it here keeps the app and its API
    # on one origin, which the session cookie relies on. EVRD_API is the load
    # balancer in front of the evrd nodes (or the one node, if that's all).
    location /api/ {
        proxy_pass $evrd_api;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;    # the message stream WebSocket
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 1h;
    }
    location /auth/ {
        proxy_pass $evrd_api;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # The web app. An update installed from Admin → Settings brings its own,
    # which evrd serves at /api/webapp/: ask evrd first, and use this
    # image's copy when it has none (404) or is restarting.
    location / {
        proxy_pass $evrd_api/api/webapp$request_uri;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_intercept_errors on;
        error_page 404 502 503 504 = @bundled;
    }
    # This image's copy, with the SPA fallback: index.html for any unknown
    # path. No internal redirects: they'd come back to evrd above.
    location @bundled {
        rewrite /$ /index.html break;
        try_files $uri @index;
    }
    location @index {
        rewrite ^ /index.html break;
    }
}
