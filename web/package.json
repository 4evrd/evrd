{
  "name": "evrd-web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "evrd web app — SvelteKit static SPA, served next to the daemon's /api.",
  "packageManager": "pnpm@11.8.0",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
