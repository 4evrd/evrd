{
  "name": "evrd-web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "evrd web app — SvelteKit static SPA, served next to the daemon's /api.",
  "packageManager": "pnpm@11.8.0",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build && node scripts/externalize-boot.js",
    "preview": "vite preview --host --port 4173",
    "prepare": "svelte-kit sync || true",
    "e2e": "playwright test",
    "e2e:install": "playwright install chromium",
    "check": "svelte-check --threshold warning",
    "test:unit": "node --test src/lib/*.test.js src/lib/i18n/*.test.js",
    "test:coverage": "node --test --experimental-test-coverage src/lib/*.test.js"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@sveltejs/adapter-static": "^3.0.8",
    "@sveltejs/kit": "^2.16.0",
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "svelte": "^5.57.2",
    "svelte-check": "4.7.7",
    "vite": "^6.2.0"
  }
}
